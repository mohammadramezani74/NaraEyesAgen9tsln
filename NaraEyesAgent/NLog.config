<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

	<!-- برای دیباگ خود NLog در صورت نیاز:
       internalLogLevel="Info"
       و خط زیر را از کامنت دربیاورید
       <internalLogFile>${basedir}\nlog-internal.log</internalLogFile>
  -->

	<!-- روت لاگ‌ها: فولدر Logs کنار خود exe  -->
	<variable name="logRoot" value="${basedir}\Logs" />

	<targets>
		<!-- فایل رولینگ: روزانه + سقف 20MB، تا 20 آرشیو -->
		<target xsi:type="File" name="file"
				fileName="${logRoot}\agent-${shortdate}.log"
				archiveFileName="${logRoot}\archive\agent.{#}.log"
				archiveNumbering="Rolling"
				archiveAboveSize="20971520"
				maxArchiveFiles="20"
				concurrentWrites="true"
				keepFileOpen="false"
				encoding="utf-8"
				createDirs="true"
				layout="${longdate}|${level:uppercase=true}|${message}${onexception:inner=${newline}${exception:format=ToString}}" />

		<!-- کنسول -->
		<target xsi:type="Console" name="console"
				layout="${longdate}|${level:uppercase=true}|${message}" />

		<!-- EventLog فقط برای Error/Fatal -->
		<target xsi:type="EventLog" name="eventlog"
				source="NaraEyesAgent"
				log="Application"
				layout="${level:uppercase=true}: ${message}${onexception:inner=${newline}${exception:format=ToString}}" />
	</targets>

	<rules>
		<!-- Info → فقط فایل -->
		<logger name="*" minlevel="Info" maxlevel="Info" writeTo="file" />
		<!-- Warn → فایل + کنسول -->
		<logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="file,console" />
		<!-- Error و بالاتر → فایل + EventLog -->
		<logger name="*" minlevel="Error" writeTo="file,eventlog" />
	</rules>
</nlog>
